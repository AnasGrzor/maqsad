# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Set to 1 to test the UI without calling Gemini or Groq (ignored in production builds).
# Paste "high", "medium", "low", "incomplete" or "error" to pick a sample report.
MOCK_AI=
# Supabase project URL and publishable (anon) key. For local dev run `supabase start` and copy them from its output.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key (bypasses RLS). Used only to store saved verification reports. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
